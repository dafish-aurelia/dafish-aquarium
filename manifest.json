{
  "manifest_version": 3,
  "name": "大肥鱼的水缸",
  "version": "2.0.0",
  "description": "本鱼的专属珊瑚礁：网页鲸鱼宠物 + 珊瑚礁新标签页",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
